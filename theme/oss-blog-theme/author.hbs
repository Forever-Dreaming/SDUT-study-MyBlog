{{!< default}}

{{!-- Author page --}}
<div class="site-header-content outer author-header">
    <div class="site-header-inner inner">
        {{#author}}
            {{#if profile_image}}
                <img class="author-profile-image large" src="{{img_url profile_image size="m"}}" alt="{{name}}" />
            {{/if}}
            <h1 class="site-title author-name">{{name}}</h1>
            {{#if bio}}
                <p class="site-description author-bio">{{bio}}</p>
            {{/if}}
            <p class="author-count">共 {{../pagination.total}} 篇文章</p>
        {{/author}}
    </div>
</div>

<main id="site-main" class="site-main outer">
<div class="inner posts">

    <div class="post-feed sdut-post-feed">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </div>

    {{pagination}}

</div>
</main>
