{{!< default}}

{{#post}}

<main id="site-main" class="site-main sdut-post-main">
<article class="article {{post_class}}">

    <header class="article-header gh-canvas sdut-article-header">

        <div class="article-tag post-card-tags">
            {{#primary_tag}}
                <span class="post-card-primary-tag">
                    <a href="{{url}}">{{name}}</a>
                </span>
            {{/primary_tag}}
            {{#if featured}}
                <span class="post-card-featured">⭐ 精选文章</span>
            {{/if}}
        </div>

        <h1 class="article-title sdut-article-title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="article-excerpt sdut-article-excerpt">{{custom_excerpt}}</p>
        {{/if}}

        <div class="article-byline sdut-byline">
        <section class="article-byline-content">
            <ul class="author-list instapaper_ignore">
                {{#foreach authors}}
                <li class="author-list-item">
                    {{#if profile_image}}
                    <a href="{{url}}" class="author-avatar" aria-label="查看 {{name}} 的更多文章">
                        <img class="author-profile-image" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="eager" />
                    </a>
                    {{else}}
                    <a href="{{url}}" class="author-avatar author-profile-image" aria-label="查看 {{name}} 的更多文章">{{> "icons/avatar"}}</a>
                    {{/if}}
                </li>
                {{/foreach}}
            </ul>
            <div class="article-byline-meta">
                <h4 class="author-name">{{authors}}</h4>
                <div class="byline-meta-content">
                    <time class="byline-meta-date" datetime="{{date format="YYYY-MM-DD"}}">
                        {{date format="YYYY年MM月DD日"}}
                    </time>
                    {{#if reading_time}}
                        <span class="byline-reading-time"><span class="bull">&bull;</span> {{reading_time minute="1 分钟阅读" minutes="% 分钟阅读"}}</span>
                    {{/if}}
                </div>
            </div>
        </section>
        </div>

        {{#if feature_image}}
            <figure class="article-image sdut-article-image">
                <img
                    class="gh-feature-image"
                    srcset="{{img_url feature_image size="s"}} 300w,
                            {{img_url feature_image size="m"}} 600w,
                            {{img_url feature_image size="l"}} 1000w,
                            {{img_url feature_image size="xl"}} 2000w"
                    sizes="(min-width: 1400px) 1400px, 92vw"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    fetchpriority="high"
                    loading="eager"
                />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}

    </header>

    <div class="sdut-article-wrapper gh-canvas">
        {{!-- Table of Contents - SDUT custom feature --}}
        {{#if @custom.show_toc}}
        <aside class="sdut-toc" id="sdutToc">
            <div class="sdut-toc-header">
                <span>📑 目录</span>
                <button class="sdut-toc-toggle" aria-label="收起目录">收起</button>
            </div>
            <div class="sdut-toc-content" id="sdutTocContent">
                <p class="sdut-toc-placeholder">正在生成目录...</p>
            </div>
        </aside>
        {{/if}}

        <section class="gh-content sdut-content">
            {{content}}
        </section>
    </div>

    {{!-- Post tags --}}
    <div class="sdut-post-tags gh-canvas">
        <span class="sdut-post-tags-label">标签:</span>
        {{#foreach tags}}
            <a href="{{url}}" class="sdut-post-tag">{{name}}</a>
        {{/foreach}}
    </div>

    {{!-- Comments --}}
    {{#if comments}}
        <section class="article-comments gh-canvas sdut-comments">
            <h3 class="sdut-comments-title">💬 评论</h3>
            {{comments}}
        </section>
    {{/if}}

</article>
</main>

{{!-- Signup CTA --}}
{{#if @site.members_enabled}}
{{#unless @member}}
{{#unless @site.comments_enabled}}
{{#if access}}
    <section class="footer-cta outer sdut-footer-cta">
        <div class="inner">
            <h2 class="footer-cta-title">喜欢这篇文章吗？</h2>
            <p class="sdut-cta-subtitle">注册会员，第一时间获取新文章通知</p>
            <a class="footer-cta-button" href="#/portal" data-portal>
                <div class="footer-cta-input">输入你的邮箱</div>
                <span>订阅</span>
            </a>
        </div>
    </section>
{{/if}}
{{/unless}}
{{/unless}}
{{/if}}

{{!-- Related posts --}}
{{#get "posts" filter="id:-{{id}}" limit="3" as |more_posts|}}
    {{#if more_posts}}
        <aside class="read-more-wrap outer sdut-read-more">
            <div class="read-more inner">
                <h3 class="sdut-read-more-title">📖 继续阅读</h3>
                <div class="sdut-read-more-grid">
                    {{#foreach more_posts}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </div>
        </aside>
    {{/if}}
{{/get}}

{{/post}}
