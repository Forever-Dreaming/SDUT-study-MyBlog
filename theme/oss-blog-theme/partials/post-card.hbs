{{!-- SDUT Blog - Custom post card partial --}}

<article class="post-card {{post_class}} sdut-post-card{{#unless access}} post-access-{{visibility}}{{/unless}}">

    {{#if feature_image}}
    <a class="post-card-image-link" href="{{url}}">
        <img class="post-card-image"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 2000w"
            sizes="(max-width: 1000px) 400px, 800px"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy"
        />
        {{#unless access}}
        {{^has visibility="public"}}
            <div class="post-card-access">
                {{> "icons/lock"}}
                {{#has visibility="members"}}会员专属{{else}}付费会员{{/has}}
            </div>
        {{/has}}
        {{/unless}}
    </a>
    {{/if}}

    <div class="post-card-content">

        <a class="post-card-content-link" href="{{url}}">
            <header class="post-card-header">
                <div class="post-card-tags">
                    {{#primary_tag}}
                        <span class="post-card-primary-tag sdut-tag">
                            <span class="sdut-tag-dot"></span>
                            {{name}}
                        </span>
                    {{/primary_tag}}
                    {{#if featured}}
                        <span class="post-card-featured sdut-featured">⭐ 精选</span>
                    {{/if}}
                </div>
                <h2 class="post-card-title sdut-card-title">
                    {{#unless access}}
                    {{^has visibility="public"}}
                        {{#unless feature_image}}
                            {{> "icons/lock"}}
                        {{/unless}}
                    {{/has}}
                    {{/unless}}
                    {{title}}
                </h2>
            </header>
            {{#if excerpt}}
                <div class="post-card-excerpt sdut-card-excerpt">{{excerpt}}</div>
            {{/if}}
        </a>

        <footer class="post-card-meta sdut-card-meta">
            <div class="sdut-meta-left">
                <time class="post-card-meta-date" datetime="{{date format="YYYY-MM-DD"}}">
                    📅 {{date format="YYYY年MM月DD日"}}
                </time>
            </div>
            <div class="sdut-meta-right">
                {{#if reading_time}}
                    <span class="sdut-read-time">⏱ {{reading_time minute="1 分钟" minutes="% 分钟"}}</span>
                {{/if}}
                {{#if @site.comments_enabled}}
                    {{comment_count}}
                {{/if}}
            </div>
        </footer>

    </div>

</article>
