# 运行时数据 - 绝不提交到 Git
runtime/

# 依赖
node_modules/
npm-debug.log*

# 主题目录下的 npm 包（flat install 产物）
theme/oss-blog-theme/.bin/
theme/oss-blog-theme/.package-lock.json
theme/oss-blog-theme/pnpm-workspace.yaml
theme/oss-blog-theme/@*/
theme/oss-blog-theme/*/
!theme/oss-blog-theme/assets/
!theme/oss-blog-theme/partials/
!theme/oss-blog-theme/locales/

# 主题目录下的上游 CI 配置（不属于本项目）
theme/oss-blog-theme/.github/
theme/oss-blog-theme/renovate.json
theme/oss-blog-theme/AGENTS.md
theme/oss-blog-theme/.gitignore
theme/oss-blog-theme/LICENSE

# 主题根级别的冗余文件（已纳入 assets/ 或 locales/）
theme/oss-blog-theme/built/
theme/oss-blog-theme/screenshot-*.jpg
theme/oss-blog-theme/*.json
!theme/oss-blog-theme/package.json
!theme/oss-blog-theme/context.json

# gscan 报告和备份目录
docs/gscan-report.txt
exports/backup-*/

# 系统文件
.DS_Store
Thumbs.db

# 敏感信息
*.key
*.pem
*.env.local

# 导出文件
exports/*.json
!exports/README.md
